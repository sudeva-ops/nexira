# Response headers for the single-page app (Prompt 16, OWASP ASVS V14.4).
# ${NEXIRA_OIDC_ORIGIN} is filled in at image build time from VITE_OIDC_URL.
# connect-src: the API and WebSocket are same-origin; the IdP origin is where
# keycloak-js exchanges and refreshes tokens. Blueprint and React set style
# attributes, hence 'unsafe-inline' for styles only; MapLibre runs its workers
# from blob: URLs. No script may come from anywhere but this origin.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; child-src blob:; connect-src 'self' ${NEXIRA_OIDC_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${NEXIRA_OIDC_ORIGIN}; object-src 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "no-referrer" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;

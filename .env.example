# NEXIRA local configuration. Copy to .env (`make up` does this for you).
# These values are for local development only. Never commit .env.

APP_ENV=local

# --- PostgreSQL (D-01) -------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=local-superuser-pw
NEXIRA_DB=nexira
NEXIRA_OWNER_PASSWORD=local-owner-pw
NEXIRA_API_PASSWORD=local-api-pw
# For running the backend, tests and Alembic on the host. Inside docker-compose the
# host is "postgres"; compose builds those DSNs from the passwords above.
DATABASE_URL=postgresql+asyncpg://nexira_api:local-api-pw@localhost:5432/nexira
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://nexira_owner:local-owner-pw@localhost:5432/nexira
# Superuser DSN used by backend tests ONLY to create throwaway databases (nexira_test*).
# Never give this to the application.
TEST_ADMIN_DATABASE_URL=postgresql://postgres:local-superuser-pw@localhost:5432/postgres

# --- Redis --------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Keycloak / OIDC (D-04, plan G-04) ------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-pw
# The issuer is pinned to the browser-facing URL; JWKS is fetched internally.
OIDC_ISSUER=http://localhost:8080/realms/nexira-demo
OIDC_JWKS_URL=http://localhost:8080/realms/nexira-demo/protocol/openid-connect/certs
OIDC_AUDIENCE=nexira-api

# --- Backend --------------------------------------------------------------------
BACKEND_PORT=8000
HOME_TZ=Asia/Dubai
LLM_PROVIDER=stub
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
# JSON list of tenant UUIDs the background workers serve (plan G-01).
WORKER_TENANT_IDS=[]
UNDO_WINDOW_S=300

# --- Frontend -------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_HOME_TZ=Asia/Dubai
VITE_DEMO_MODE=true

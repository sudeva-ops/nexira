{
  "realm": "nexira-demo",
  "displayName": "NEXIRA demo (fictional users only)",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "nexira-web",
      "name": "NEXIRA web app",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "${NEXIRA_PUBLIC_ORIGIN:http://localhost:3000}/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "${NEXIRA_PUBLIC_ORIGIN:http://localhost:3000}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*##${NEXIRA_PUBLIC_ORIGIN:http://localhost:3000}/*"
      },
      "protocolMappers": [
        {
          "name": "nexira-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "nexira-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "nexira-dev-cli",
      "name": "Local scripts and tests only (password grant)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "nexira-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "nexira-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
